{
  "name": "agent-thread-tools",
  "version": "2.0.0",
  "description": "CLI health checks, handoffs, session archives, visual archives, and recovery tools for OpenAI Codex and Claude Code session threads.",
  "license": "MIT",
  "author": "Rich Olson",
  "type": "commonjs",
  "bin": {
    "agent-thread-tools": "bin/agent-thread-tools.js",
    "codex-thread-tools": "bin/agent-thread-tools.js"
  },
  "files": [
    "bin/agent-thread-tools.js",
    "agent_thread_tools/*.py",
    "tools/*.py",
    "docs/README.md",
    "docs/installation.md",
    "docs/health.md",
    "docs/handoff.md",
    "docs/session-archive.md",
    "docs/visual-archive.md",
    "docs/recovery.md",
    "docs/compaction.md",
    "docs/claude-code.md",
    "docs/publishing.md",
    "docs/development.md",
    "skills/codex-thread-handoff/SKILL.md",
    "skills/codex-thread-handoff/agents/*.yaml",
    "skills/codex-thread-handoff/references/*.md",
    "skills/thread-handoff/SKILL.md",
    "skills/thread-handoff/references/*.md",
    "assets/agent-thread-tools-header.png",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "VERSION",
    "LICENSE"
  ],
  "scripts": {
    "test": "python3 -m pytest",
    "pack:dry-run": "npm pack --dry-run"
  },
  "keywords": [
    "codex",
    "claude-code",
    "claude",
    "openai-codex",
    "openai",
    "codex-thread",
    "agent-thread",
    "coding-agent",
    "codex-session",
    "session-health",
    "thread-health",
    "session-archive",
    "thread-archive",
    "handoff",
    "compaction",
    "session-jsonl",
    "developer-tools",
    "cli"
  ],
  "homepage": "https://github.com/zenzig/agent-thread-tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenzig/agent-thread-tools.git"
  },
  "bugs": {
    "url": "https://github.com/zenzig/agent-thread-tools/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
